# Copier ce fichier en .env.local et remplir avec les valeurs de ton projet Supabase.
# Tableau de bord Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Nom affiché en haut de l'application et sur le bon de dépôt.
NEXT_PUBLIC_NOM_PRESSING=Pressing Brian

# URL publique de l'application, utilisée pour construire le lien de suivi
# envoyé au client sur WhatsApp. En local, laisser http://localhost:3000
NEXT_PUBLIC_URL_PUBLIQUE=http://localhost:3000
